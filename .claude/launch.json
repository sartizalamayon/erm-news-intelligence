{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "erm-api",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "erm-frontend",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["scripts/dev_frontend_server.py", "5173", "--directory", "frontend"],
      "port": 5173
    }
  ]
}
