# Copy this file to .env and fill in real values for local development.
# .env is gitignored (see .gitignore's "Secrets" section); this example
# file is the only one tracked. In CI and on Render, these are set as
# GitHub Actions secrets / Render environment variables instead of a
# committed file.
#
# EVERY VARIABLE app.config.Settings READS IS LISTED HERE — and that is
# now a test, not a promise. tests/test_env_example_completeness.py reads
# this file, reads `Settings.model_fields`, and fails if either side has
# something the other does not. It exists because the sentence it
# replaces was already false: five real settings
# (OTP_CONSOLE_FALLBACK_ENABLED, RATE_LIMIT_REQUESTS_PER_WINDOW,
# RATE_LIMIT_WINDOW_SECONDS, MAX_REQUEST_BODY_BYTES,
# MAX_QUERY_PARAM_LENGTH) had been added to the Settings class over time
# and never documented here, so nobody deploying this could know they
# existed or what they defaulted to. That is the same "an undeclared
# field is invisible" mechanism that let a dead Gemini model reach a
# production deploy — a comment asserting completeness is exactly as
# strong as whoever last remembered to honour it, which is why this one
# is checked by a machine.

# ── App / runtime ──────────────────────────────────────────────────
APP_ENV=development            # development | test | staging | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
# NO `PORT` — there is no `Settings.port` any more. Nothing ever read it;
# uvicorn takes Render's injected $PORT directly in render.yaml's
# startCommand. Do not re-add it here without adding a reader.
SECRET_KEY=                  # Fernet key encrypting admin-entered LLM provider keys at rest (ADR §9.1). Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# SECURITY-CRITICAL, NOT A TUNING KNOB (RT-5 remediation, docs/red-team-findings.md).
# Number of reverse-proxy hops between the real client and this process
# that are trusted to have each appended their own observed peer address
# onto X-Forwarded-For. Default 0 = trust nothing: X-Forwarded-For is
# never consulted, the direct socket peer is always used. Setting this
# higher than the REAL number of trusted hops in front of the app
# reopens the per-IP OTP rate-limit bypass RT-5 found (an
# attacker-controlled X-Forwarded-For entry becomes trusted as if a real
# proxy appended it) — this is a security bug, not something to tune for
# convenience. Render alone counts as 1 hop; an additional CDN/WAF in
# front adds more. Set to the exact real count for your topology; never guess.
TRUSTED_PROXY_HOPS=0

# ── Database — Supabase Postgres (ADR §1, changed from Neon in §9.4) ─
DATABASE_URL=                  # postgresql://user:password@host:port/dbname ; required in production (see app.config.validate_production_settings), blank is fine for local dev/CI until ARCH-DB's fixture DB exists

# ── LLM providers (ADR §9.1, ruled: Groq primary, Google AI Studio secondary) ─
# These are the bootstrap/CI/local fallback only — admin-configurable
# keys entered via the future admin dashboard are stored encrypted in
# the database instead (ARCH-DB/ADMIN-API), not read from here.
# NEVER put a real key value in this file — real keys live in `.env`
# (gitignored). Live-verified 2026-08-07 against real keys; see
# provider-limits-VERIFIED.md (news-intel-rebuild docs) for the full
# picture — summary below.
#
# ⚠ DO NOT SET `*_MODEL` HERE. Leave every one of them blank.
#
# Model ids live in ONE place: `DEFAULT_PROVIDER_DEFINITIONS` in
# app/services/llm/provider_registry.py. That is the only place they are
# ever probed against a live key, and it currently pins:
#
#     groq     llama-3.1-8b-instant      (14,400 RPD / 500,000 TPD)
#     gemini   gemini-flash-lite-latest  (an ALIAS, on purpose — see below)
#     mistral  mistral-small-latest
#     nvidia   meta/llama-3.1-8b-instruct
#
# A non-blank value here OVERRIDES that registry for the deployment that
# sets it, and nothing re-probes it afterwards. This file used to
# recommend `qwen/qwen3.6-27b` and `gemini-2.0-flash`; the first caps at
# 1,000 RPD against a ~1,100 req/day workload and wastes reasoning
# tokens on short JSON verdicts, and the second is now DEAD — Google
# returns HTTP 404 "no longer available" for it on every key this
# project holds. Gemini is the secondary for all five features, so
# pinning it would silently break the entire failover path.
#
# Set one of these only to deliberately pin a different model than the
# registry's, and only after probing it against a real key — Gemini in
# particular lists models via its API that then 404 on call.
GROQ_API_KEY=                  # from console.groq.com
GROQ_MODEL=                    # blank = use provider_registry's (recommended)
GEMINI_API_KEY=                # from Google AI Studio (aistudio.google.com)
GEMINI_MODEL=                  # blank = use provider_registry's (recommended)
MISTRAL_API_KEY=                # from console.mistral.ai — verified working 2026-08-07, 50,000 TPM / 50 RPM, NO thinking-token overhead (unlike Groq/Gemini). No daily ceiling exposed by the API; treat TPD/RPD as unknown, never assume unlimited.
MISTRAL_MODEL=                 # blank = use provider_registry's (recommended)
NVIDIA_API_KEY=                 # optional bootstrap key, parity with GROQ/GEMINI/MISTRAL — admin-DB-configured routing is P3-LLM's primary design for this provider
# NVIDIA has no *_MODEL var at all, deliberately — that is the shape to
# copy when adding a provider.
# NO `LLM_PROVIDER_PRIMARY` / `LLM_PROVIDER_SECONDARY` — these used to be
# listed here, and setting them did nothing at all. Provider routing is
# per-FEATURE and lives in app/services/llm/routing.py, whose hardcoded
# fallback is Mistral primary / Gemini secondary (measured; see that
# module), overridden per feature by admin-stored config in the database.
# So these two not only had no reader, they stated the wrong answer:
# anyone who set LLM_PROVIDER_PRIMARY in the Render dashboard would have
# believed the pipeline ran on Groq, with no error and no effect. Both
# fields are gone from app/config.py too.
# Cerebras was evaluated and rejected: valid key, but every real call
# returns HTTP "payment_required" (provider-limits-VERIFIED.md's "Round
# 2") — no usable free quota on the available account. Do not add a
# CEREBRAS_API_KEY var; there is nothing for it to configure.

# ── Resend (OTP email transport — ADR §9.3, ruled: OTP-only auth) ────
# There is no SMTP server anywhere in this system — Resend is called
# over its REST API via `requests` (app/services/email.py), not SMTP.
# No smtp_* variables exist here on purpose — see app/config.py's
# module docstring; four previously-provisioned, always-unused ones
# were removed as dead weight that recreated exactly the naming
# confusion the RESEND_* rename above was meant to fix.
RESEND_API_KEY=                 # Resend API key (dashboard → API Keys), sent as a Bearer token; never logged
RESEND_FROM_EMAIL=              # verified Resend sender address, e.g. otp@yourdomain.example

# Brevo — the ACTIVE email provider (live-verified: two real emails
# delivered to a @grameenphone.com inbox, landed in Junk -- expected,
# see app/services/email.py's docstring). Resend needs a verified
# sending domain grameenphone.com does not have and the owner has ruled
# out getting; Brevo needs only an API key. EMAIL_PROVIDER selects which
# transport app.services.email calls; Resend is kept fully working as
# the non-default alternative.
EMAIL_PROVIDER=brevo             # resend | brevo -- default brevo, see app/config.py
BREVO_API_KEY=                   # Brevo API key, sent as the api-key header (NOT Bearer)
BREVO_FROM_EMAIL=                # Brevo sender address, e.g. noshinarthi9@gmail.com (freemail -- accepted deliverability risk)
BREVO_FROM_NAME=                 # Brevo sender display name, e.g. ERM

# When 1/true AND APP_ENV is not production/staging, an unconfigured mail
# provider logs the OTP code to the server console (WARNING) instead of
# failing the request — this is what makes local/dev/CI login work with
# no mail account at all. ALWAYS forced off in production/staging
# regardless of this value (app.services.email._console_fallback_allowed):
# a deploy that prints login codes into its own log stream is not a
# fallback, it is an unauthenticated login. Set to 0 in dev only to
# exercise the real failure path.
OTP_CONSOLE_FALLBACK_ENABLED=1

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=            # comma-separated frontend origins, e.g. https://erm-frontend.onrender.com

# ── Hardening — whole-API request limits (HARDEN, docs/security.md) ───
# Read by app.main.create_app() and app.middleware.*. All four have
# working defaults and none needs to be set on Render; they are listed
# because they exist and are settable, which is the entire point of this
# file. None of them is the OTP limiter — app.services.auth keeps its own
# per-email (3/15min) and per-IP (10/15min) OTP limits in code, and those
# are not env-tunable on purpose.
RATE_LIMIT_REQUESTS_PER_WINDOW=120   # max requests per resolved client IP per window, every route. In-process, so per Render instance — not global if this is ever scaled past one.
RATE_LIMIT_WINDOW_SECONDS=60         # the sliding window, in seconds, that the count above applies to
MAX_REQUEST_BODY_BYTES=1000000       # hard cap on any request body, rejected with 413 BEFORE parsing. 1MB is generous for every admin form (keywords, prompts, source config).
MAX_QUERY_PARAM_LENGTH=2000          # max characters in any single query-string value; bounds the GIN-indexed search input

# ── Dashboard macro indicators (MACRO-DASHBOARD) ────────────────────────
# Taka/USD (open.er-api.com) and inflation (World Bank) are free and
# keyless — no env var needed. Brent needs a free account.
OILPRICEAPI_KEY=                # free API key from https://www.oilpriceapi.com/auth/signup (no credit card, 200 req/month) — blank = Brent card shows "not configured", not a fake zero

# ── LLM pipeline tuning knobs — REAL, and NOT Settings fields (M16) ────
#
# READ THIS BEFORE USING ANY OF THEM. Every variable below is read
# directly from `os.environ` inside a service module, NOT through
# `app.config.Settings`. That breaks app/config.py's own stated rule
# ("nowhere else should call os.environ directly for application
# config"), and it has a concrete deployment cost: because they are not
# Settings fields, they are not in render.yaml's envVars list, so the
# Render dashboard never prompts for them and nothing validates them.
# They are documented here — rather than left undiscoverable — because
# an operator debugging a slow or expensive nightly run has no other way
# to learn they exist. Migrating them into `Settings` is outstanding
# work, deliberately not done in this pass: app/services/enrichment.py
# and app/services/llm/transport.py are another agent's files.
#
# Setting any of these on Render requires adding it to render.yaml's
# envVars by hand (there is a matching comment block there).
#
# Stage switches — app/services/enrichment.py's `_env_flag`: "0" turns
# the stage OFF, ANY other value (including "false", "no" and an empty
# string) leaves it ON. Only ever consulted on a FULL run; an explicit
# per-stage run from the admin Run screen ignores them entirely.
LLM_TRANSLATE=1                  # headline/body translation stage
LLM_DEDUP=1                      # cross-source duplicate grouping stage
LLM_JUDGE=1                      # relevance scoring stage (the one that writes llm_score)
LLM_TOPIC=1                      # topic clustering stage
# Batch sizes — how many items go into one LLM call. Larger = fewer
# calls (cheaper against RPD ceilings) but a bigger blast radius when a
# single malformed response makes the whole batch unusable, and more
# tokens per call against TPM ceilings. Parsed with a bare int()/float():
# a non-numeric value is a crash mid-run, not a fallback to the default.
LLM_BATCH=10                     # items per judge/scoring call (app/services/llm/parsing.py BATCH_SIZE_JUDGE_DEFAULT)
LLM_TOPIC_CHUNK=50               # items per topic-clustering chunk (BATCH_SIZE_TOPIC_CHUNK_DEFAULT)
LLM_TOPIC_DEDUP_BATCH=8          # topic groups per cross-chunk fold call (BATCH_SIZE_TOPIC_DEDUP_DEFAULT)
TOPIC_PREFOLD_THRESH=0.82        # 0..1 cosine-ish similarity above which two topics are folded locally BEFORE any LLM call (p3-contract.md §6.3). Higher = fold less, more LLM work.
# Transport retries — app/services/llm/transport.py. Named GROQ_RETRIES
# for legacy parity, but it is NOT Groq-specific any more: it is the
# retry count for EVERY OpenAI-compatible provider (Groq, Mistral,
# NVIDIA). Gemini has its own path and does not read this.
GROQ_RETRIES=4
